# Copy this file to ".env" and fill what you have. ALL are optional & free —
# the engine degrades gracefully (skips the step) if a key is missing.

# Australian Business Register — free GUID from https://abr.business.gov.au/Tools/WebServices
# Used by find.py to verify a business has an active ABN. Missing = ABN check skipped.
ABN_GUID=

# Google PageSpeed Insights — free key from https://developers.google.com/speed/docs/insights/v5/get-started
# Only raises your quota; audit.py still runs PSI without it, just slower.
PSI_KEY=

# Google Places — OFF by default. Only used if present AND inside the free tier.
GOOGLE_PLACES_KEY=
